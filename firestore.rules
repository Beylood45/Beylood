rules_version = '2';

// ============================================================
// Beylood — Firestore Security Rules
// ------------------------------------------------------------
// Principle: a signed-in user may read/write ONLY their own
// document and their own bookmarks. Admins (listed in
// /admins/{uid}) may read everyone's profile for the dashboard.
// Paste these into Firebase Console → Firestore → Rules → Publish.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // True only when the request is authenticated AND the uid in
    // the path belongs to the caller. This is the core guard.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Admin = there is a document at /admins/{caller.uid}.
    // (We never read the body, just the existence.)
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Validate the shape of a user profile document. Rejecting
    // unexpected fields and oversized strings stops abuse such as
    // someone stuffing large/extra data into the database.
    function validUser() {
      let d = request.resource.data;
      let allowed = [
        'name', 'displayName',
        'email',
        'photoURL',
        'provider',
        'country', 'city',
        'createdAt', 'updatedAt', 'lastLogin',
        'bookmarksCount', 'articlesRead', 'loginCount'
      ];
      return d.keys().hasOnly(allowed)
        && (!('name' in d)         || (d.name is string         && d.name.size() <= 80))
        && (!('displayName' in d)  || (d.displayName is string  && d.displayName.size() <= 80))
        && (!('email' in d)        || (d.email is string        && d.email.size() <= 254))
        && (!('photoURL' in d)     || (d.photoURL is string     && d.photoURL.size() <= 2048))
        && (!('provider' in d)     || (d.provider is string     && d.provider.size() <= 32))
        && (!('country' in d)      || (d.country is string      && d.country.size() <= 40))
        && (!('city' in d)         || (d.city is string         && d.city.size() <= 60))
        && (!('bookmarksCount' in d) || (d.bookmarksCount is int && d.bookmarksCount >= 0 && d.bookmarksCount <= 100000))
        && (!('articlesRead' in d)   || (d.articlesRead is int   && d.articlesRead   >= 0 && d.articlesRead   <= 100000))
        && (!('loginCount' in d)     || (d.loginCount is int     && d.loginCount     >= 0 && d.loginCount     <= 100000));
    }

    match /users/{uid} {
      // Read your own profile. Admins can read every profile so the
      // admin dashboard can render charts and counters.
      allow read: if isOwner(uid) || isAdmin();

      // Listing all users (collection-level query) is admin-only.
      // (Per-doc reads are still covered by the rule above.)
      // Firestore evaluates listing via the same `read` rule, so the
      // OR with isAdmin() handles both cases.

      // Create your own profile, with a valid shape.
      allow create: if isOwner(uid) && validUser();

      // Update your own profile, valid shape, and the email field
      // can never be changed once set (prevents identity tampering).
      allow update: if isOwner(uid)
        && validUser()
        && (!('email' in request.resource.data) || !('email' in resource.data) || request.resource.data.email == resource.data.email);

      // Profiles are never deleted from the client.
      allow delete: if false;

      // ---- Saved articles (bookmarks) ----
      match /bookmarks/{docId} {
        allow read: if isOwner(uid);

        // Create/update a bookmark: only the expected fields, capped sizes.
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['title', 'url', 'savedAt'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 200
          && request.resource.data.url is string && request.resource.data.url.size() <= 200;

        allow delete: if isOwner(uid);
      }
    }

    // ---- Admin registry ----
    // Each document represents one admin. The doc ID is the user's
    // uid. Writes must be done in the Firebase Console only — never
    // from the client.
    match /admins/{uid} {
      // The signed-in caller may read their OWN admin doc to
      // confirm whether they are an admin (used by admin.html).
      allow read: if isOwner(uid);
      // Listing the admin registry from the client is denied.
      // Adding or removing admins must be done in the console.
      allow write: if false;
    }

    // ---- Site-wide stats (counters) ----
    // Public counters (e.g. total page views) that the dashboard
    // can show without leaking per-user info. Admin-only writes.
    match /stats/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny everything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
