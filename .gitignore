# ============================================================
# Beylood — .gitignore
# ============================================================

# --- Secrets / environment (NEVER commit) ---
.env
.env.local
.env.*.local
*.key
# (note: .env.local.example is a safe template and stays tracked)

# --- Dependencies ---
node_modules/

# --- Build / cache / deploy output ---
.vercel/
.next/
dist/
build/
.cache/
*.log
npm-debug.log*

# --- Claude Code internal (worktrees + local settings) ---
.claude/

# --- FUSE / mount tombstones ---
.fuse_hidden*

# --- OS junk ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.orig
*.tmp
